# These are environment variables, not automatically loaded from this file.
# Export only the settings you need in your shell.
CUTROOM_ASR=http://127.0.0.1:8835
ASR_MODEL=openai/whisper-large-v3-turbo
ASR_PORT=8835
ASR_LANGUAGE=english
# Set this for your GPU; the original 0.06 fraction was for a 128 GB Spark.
ASR_GPU_FRACTION=0.5
CUTROOM_FF_THREADS=4
CUTROOM_KEEP_MIN=7
CUTROOM_DAILY_MIN=3
# Optional operator token for the local room's manual clip endpoint.
# Generate your own value. No deployment credentials are distributed.
CUTROOM_OP=
